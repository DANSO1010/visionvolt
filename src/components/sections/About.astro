---
import { siteContent } from "../../data/siteContent";
---

<section
  id="about"
  class="scroll-mt-28 bg-surface px-4 py-24 sm:scroll-mt-36 sm:px-margin-desktop"
>
  <div class="max-w-4xl border-l-4 border-primary-container pl-12">
    <span class="mb-2 block font-mono text-sm text-hud-blue-light">[ABOUT_PARTNER]</span>
    <h2 class="mb-8 text-[40px] font-bold leading-tight text-white">About {siteContent.company.name}</h2>
    <div class="space-y-6 text-lg leading-relaxed text-text-secondary">
      {siteContent.company.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>
