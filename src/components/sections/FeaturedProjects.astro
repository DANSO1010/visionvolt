---
import { Image } from "astro:assets";
import { siteContent } from "../../data/siteContent";
---

<div class="mb-16 flex flex-col gap-16">
  {
    siteContent.featuredProjects.map((project, index) => (
      <div class="grid grid-cols-1 gap-8 border border-border-technical bg-surface-slate/20 p-6 md:grid-cols-2 md:p-8">
        <div class={`grid grid-cols-2 gap-3 ${index % 2 === 1 ? "md:order-2" : ""}`}>
          {project.images.map((image, i) => (
            <Image
              src={image}
              alt={`${project.title}, view ${i + 1}`}
              loading="lazy"
              decoding="async"
              class={`h-40 w-full border border-border-technical object-cover md:h-48 ${i === 0 ? "col-span-2" : ""} ${project.imagePositions?.[i] ?? ""}`}
            />
          ))}
        </div>

        <div class="flex flex-col justify-center">
          <span class="mb-2 font-mono text-[11px] text-hud-blue-light">{project.category}</span>
          <h3 class="mb-4 text-2xl font-bold text-white">{project.title}</h3>
          <p class="mb-6 text-text-secondary">{project.description}</p>
          <div class="flex flex-wrap gap-3">
            {project.highlights.map((highlight) => (
              <span class="border border-primary-container bg-surface-slate px-4 py-1.5 font-mono text-[11px] text-primary">
                {highlight}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))
  }
</div>
